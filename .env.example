# Environment
NODE_ENV=development
TZ=Europe/Zurich

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis (BullMQ)
REDIS_URL=redis://localhost:6379

# OpenAI
OPENAI_API_KEY=sk-...

# Asset Generation (optional)
IMAGE_GEN_API_KEY=
RUNWAY_API_KEY=
ELEVENLABS_API_KEY=

# Meta / Instagram
META_APP_ID=your-app-id
META_APP_SECRET=your-app-secret
META_PAGE_ID=your-page-id
IG_USER_ID=your-instagram-business-account-id
META_ACCESS_TOKEN=your-long-lived-token

# TikTok
TIKTOK_CLIENT_KEY=your-client-key
TIKTOK_CLIENT_SECRET=your-client-secret
TIKTOK_ACCESS_TOKEN=your-access-token

# Public URLs
PUBLIC_BASE_URL=https://content.lxstudio.ch

# Fallback & Alerts
BUFFER_WEBHOOK_URL=https://hooks.buffer.com/...
ALERT_WEBHOOK_URL=https://hooks.slack.com/services/...

# Publishing Mode (direct|webhook)
PUBLISH_MODE=direct

# Feature Flags
ENABLE_ASSET_RENDER=false
ENABLE_DIRECT_PUBLISH=true
ENABLE_ANALYTICS_PULL=false
DRY_RUN_MODE=false

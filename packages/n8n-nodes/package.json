{
  "name": "@lxstudio/n8n-nodes",
  "version": "1.0.0",
  "description": "Custom n8n nodes pour LX Studio content automation",
  "main": "index.js",
  "scripts": {
    "build": "tsc && cp package.json dist/",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [],
    "nodes": [
      "dist/nodes/GenerateContent/GenerateContent.node.js",
      "dist/nodes/SchedulePosts/SchedulePosts.node.js",
      "dist/nodes/PublishPosts/PublishPosts.node.js"
    ]
  },
  "keywords": ["n8n-community-node-package", "lxstudio"],
  "license": "MIT",
  "devDependencies": {
    "n8n-workflow": "^1.0.0",
    "typescript": "^5.3.3"
  }
}

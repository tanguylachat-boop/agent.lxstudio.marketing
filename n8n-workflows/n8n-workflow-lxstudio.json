          ]
        },
        "options": {}
      },
      "name": "Schedule Posts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [1050, 500]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$env.PUBLISH_MODE}}",

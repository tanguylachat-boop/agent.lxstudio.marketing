            {
              "name": "idea_id",
              "value": "={{$json.idea_id}}"
            },
            {
              "name": "script_id",
              "value": "={{$json.script_id}}"
            },
            {
              "name": "shots",
              "value": "={{JSON.stringify($json.shots)}}"
            },
            {
              "name": "subtitles",
              "value": "true"
            },
            {
              "name": "watermark",
              "value": "{\"enabled\":true,\"text\":\"LX Studio\",\"position\":\"bottom-right\"}"
            }
          ]
        },
        "options": {}
      },
      "name": "Compose Assets",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [850, 500]

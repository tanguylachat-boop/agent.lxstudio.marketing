          "parameters": [
            {
              "name": "idea_id",
              "value": "={{$json.idea_id}}"
            },
            {
              "name": "script_text",
              "value": "={{$json.script.script_text}}"
            }
          ]
        },
        "options": {}
      },
      "name": "Generate Caption",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [650, 500]
    },
    {
      "parameters": {

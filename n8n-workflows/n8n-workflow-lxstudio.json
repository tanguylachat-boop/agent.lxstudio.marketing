        "bodyParameters": {
          "parameters": [
            {
              "name": "idea_id",
              "value": "={{$json.idea_id}}"
            },
            {
              "name": "duration_target_s",
              "value": "15"
            }
          ]
        },
        "options": {}
      },
      "name": "Generate Script",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [450, 500]
    },
    {
      "parameters": {
        "url": "={{$env.API_BASE_URL}}/api/caption",

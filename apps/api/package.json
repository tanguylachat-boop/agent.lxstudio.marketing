{
  "name": "@lxstudio/api",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "queue:worker": "tsx src/queue/worker.ts",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "type-check": "tsc --noEmit",
    "lint": "echo 'Linting API...'",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@lxstudio/schemas": "workspace:*",
    "@lxstudio/ai": "workspace:*",
    "@lxstudio/integrations": "workspace:*",
    "@supabase/supabase-js": "^2.39.0",
    "fastify": "^4.25.2",
    "@fastify/cors": "^8.5.0",
    "@fastify/rate-limit": "^9.1.0",
    "bullmq": "^5.1.0",
    "ioredis": "^5.3.2",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
